---
import PageLayout from "@presentation/layouts/PageLayout.astro";
---

<PageLayout title="¡Gracias!" description="Mensaje enviado.">
  <section class="min-h-screen flex items-center justify-center bg-skin-primary px-4 text-skin-text">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">
        ¡Gracias!
      </h1>
      <p class="mb-8 text-xl text-skin-muted md:text-2xl">
        Recibí tu mensaje. Podés seguir viendo el sitio o volver al inicio.
      </p>
      <a
        href="/"
        class="focus-ring inline-flex min-h-11 items-center rounded-xl bg-brand-primary px-8 py-3 font-semibold text-white hover:bg-brand-hover"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</PageLayout>
